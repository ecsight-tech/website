---
interface Props {
  brand?: string;
  email?: string;
  rights: string;
}

const { brand = "ecsight", email, rights } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 py-12">
  <div
    class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-6 md:flex-row md:items-center"
  >
    <div class="font-heading text-lg font-semibold tracking-tight">
      {brand}<span class="text-primary">.</span>
    </div>
    <p class="text-sm text-foreground/60">
      &copy; {year} {brand}. {rights}
    </p>
    {
      email ? (
        <a
          href={`mailto:${email}`}
          class="text-sm text-foreground/70 hover:text-foreground"
        >
          {email}
        </a>
      ) : null
    }
  </div>
</footer>
