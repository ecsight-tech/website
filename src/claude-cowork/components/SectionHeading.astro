---
import { workshop } from "../data/content";

interface Props {
  eyebrow?: string;
  title: string;
  align?: "left" | "center";
  className?: string;
}

const { eyebrow, title, align = "left", className = "" } = Astro.props;
const alignCls =
  align === "center" ? "items-center text-center" : "items-start text-left";
---

<div class={`flex flex-col gap-8 ${alignCls} ${className}`}>
  {
    eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand md:text-base">
        {eyebrow}
      </p>
    )
  }
  <h2
    class="text-4xl font-semibold leading-[1.1] tracking-[-0.02em] text-ink md:text-5xl lg:text-6xl"
  >
    {title}
  </h2>
</div>
