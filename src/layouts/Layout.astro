---
import "@/styles/global.css";

import type { Locale } from "@/i18n/ui";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Pages default to the dark theme; standalone funnels can opt into light. */
  theme?: "dark" | "light";
  /** Social share image, a path under /public (e.g. "/workshop/og.jpg"). */
  image?: string;
}

const {
  locale,
  title = "Ecsight Group",
  description = "Ecsight Group is a digital agency building bold brands, products, and experiences for ambitious teams.",
  theme = "dark",
  image,
} = Astro.props;

// Social crawlers need absolute URLs.
const imageUrl = image && new URL(image, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={locale} class:list={[theme === "dark" && "dark", "h-full antialiased"]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- SVG favicon (adapts to light/dark tabs); .ico for browsers without SVG favicon support. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300..700&family=Noto+Sans+Thai:wght@300..700&family=Geist+Mono:wght@400..600&display=swap"
    />
    <slot name="head" />
  </head>
  <body class="min-h-full bg-background font-sans text-foreground">
    <slot />
    <script>
      import Lenis from "lenis";

      const lenis = new Lenis({ lerp: 0.1, anchors: true, autoRaf: true });

      // Lenis caches the scroll limit at init; lazy images and the marquee
      // grow the page afterwards, leaving the bottom unreachable. Recalc on
      // any content size change and once everything has loaded.
      const resize = () => lenis.resize();
      new ResizeObserver(resize).observe(document.body);
      window.addEventListener("load", resize);
    </script>
  </body>
</html>
