---
import { localeHref, type Locale } from "@/i18n/ui";

interface Social {
  platform?: string;
  url?: string;
}

interface Props {
  locale: Locale;
  brand?: string;
  email?: string;
  phone?: string;
  address?: string;
  socials?: Social[];
  description?: string;
  t: {
    rights: string;
    contact: string;
    follow: string;
    address: string;
    journey: string;
    privacy: string;
  };
}

const {
  locale,
  brand = "1 Ecsight Group",
  email,
  phone,
  address,
  socials = [],
  description,
  t,
} = Astro.props;
const year = new Date().getFullYear();
const privacyHref = `${localeHref(locale)}privacy-policy`;
---

<footer
  class="overflow-hidden border-t border-white/10 pt-16 h-[60vh] flex flex-col justify-between items-center"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-6 md:grid-cols-2 md:gap-8"
  >
    <div>
      <img src="/logo.svg" alt="Ecsight" class="mb-4 size-10" />
      <h2 class="font-heading text-xl font-semibold tracking-tight">
        1 Ecsight Group Co., Ltd.
      </h2>
      {
        description ? (
          <p class="mt-4 max-w-md text-sm leading-relaxed text-foreground/60">
            {description}
          </p>
        ) : null
      }
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 md:justify-items-start">
      {
        email ? (
          <div>
            <h3 class="font-medium">{t.contact}</h3>
            <a
              href={`mailto:${email}`}
              class="mt-1 block text-sm text-foreground/60 transition-colors hover:text-foreground"
            >
              {email}
            </a>
            {phone ? (
              <a
                href={`tel:${phone}`}
                class="mt-1 block text-sm text-foreground/60 transition-colors hover:text-foreground"
              >
                {phone}
              </a>
            ) : null}
          </div>
        ) : null
      }

      {
        socials.length ? (
          <div>
            <h3 class="font-medium">{t.follow}</h3>
            <ul class="mt-1 space-y-1">
              {socials.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-foreground/60 transition-colors hover:text-foreground"
                  >
                    {s.platform}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : null
      }

      {
        address ? (
          <div>
            <h3 class="font-medium">{t.address}</h3>
            <p class="mt-1 whitespace-pre-line text-sm text-foreground/60">
              {address}
            </p>
          </div>
        ) : null
      }
    </div>
  </div>

  <div
    class="mx-auto mt-12 flex w-full max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-6 text-xs text-foreground/40"
  >
    <p>&copy; {year} {brand.toLocaleUpperCase()}. {t.rights}</p>
    <a href={privacyHref} class="transition-colors hover:text-foreground">
      {t.privacy}
    </a>
  </div>

  <div
    class="mt-10 p-4 flex w-full select-none items-end gap-[2vw]"
    aria-hidden="true"
  >
    <img src="/ecsight_logo_text.svg" alt="" class="w-full m-auto opacity-5" />
  </div>
</footer>
