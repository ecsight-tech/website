import { ScrollExpandCard } from "@/components/workshop/scroll-expand-card";
import { WhyLoop, type WhyLoopVariant } from "@/components/workshop/why-loops";
import { PhotoStack } from "@/components/workshop/photo-stack";
import ClassBackdrop from "@/components/workshop/ClassBackdrop.astro";
