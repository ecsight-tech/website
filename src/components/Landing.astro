---
import { sanityClient } from "sanity:client";

import Layout from "@/layouts/Layout.astro";
import { getMessages, type Locale } from "@/i18n/ui";
import {
  servicesQuery,
  mediaEventsQuery,
  academyQuery,
  featuredProjectsQuery,
  partnersQuery,
  showcaseQuery,
  siteSettingsQuery,
} from "@/sanity/lib/queries";
import { SiteHeader, type HeaderSettings } from "@/components/site/site-header";
import SiteFooter from "@/components/site/SiteFooter.astro";
import { Hero } from "@/components/sections/hero";
import { Services } from "@/components/sections/services";
import { MediaEvent } from "@/components/sections/media-event";
import { Academy } from "@/components/sections/academy";
import { Partners } from "@/components/sections/partners";
import { Work } from "@/components/sections/work";
import { TrustedBy } from "@/components/sections/trusted-by";
import { ContentShowcase } from "@/components/sections/content-showcase";
import { CTA } from "@/components/sections/cta";
import Contact from "@/components/sections/contact.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getMessages(locale);
const params = { locale };

type SiteSettings =
  | (HeaderSettings & {
      email?: string;
      phone?: string;
      address?: string;
      description?: string;
      socials?: { platform?: string; url?: string }[];
    })
  | null;

const [services, mediaEvents, academy, projects, partners, showcase, settings] =
  await Promise.all([
    sanityClient.fetch(servicesQuery, params),
    sanityClient.fetch(mediaEventsQuery, params),
    sanityClient.fetch(academyQuery, params),
    sanityClient.fetch(featuredProjectsQuery, params),
    sanityClient.fetch(partnersQuery, params),
    sanityClient.fetch(showcaseQuery, params),
    sanityClient.fetch<SiteSettings>(siteSettingsQuery, params),
  ]);

const email = settings?.email;
---

<Layout locale={locale}>
  <SiteHeader
    client:load
    settings={settings ?? undefined}
    locale={locale}
    t={t.nav}
  />
  <main>
    <Hero client:load t={t.hero} />
    <TrustedBy client:visible t={t.trustedBy} />

    <Services client:visible services={services} heading={t.services.heading} />
    <!-- <MediaEvent
      client:visible
      items={mediaEvents}
      heading={t.mediaEvent.heading}
    /> -->
    <Partners client:load partners={partners} heading={t.partners.heading} />
    <Academy client:visible items={academy} heading={t.academy.heading} />
    <!-- <CTA client:load email={email} t={t.cta} /> -->
    <!-- <ContentShowcase
      client:visible
      items={showcase}
      heading={t.showcase.heading}
    /> -->
    <Work client:visible projects={projects} t={t.work} />
    <Contact
      t={t}
      email={email}
      phone={settings?.phone}
      address={settings?.address}
      socials={settings?.socials}
    />
  </main>
  <SiteFooter
    email={email}
    phone={settings?.phone}
    address={settings?.address}
    socials={settings?.socials}
    description={settings?.description}
    t={t.footer}
  />
</Layout>
