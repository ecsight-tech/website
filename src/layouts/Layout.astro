---
import "@/styles/global.css";

import type { Locale } from "@/i18n/ui";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const {
  locale,
  title = "ecsight — Digital Agency",
  description = "ecsight is a digital agency building bold brands, products, and experiences for ambitious teams.",
} = Astro.props;
---

<!doctype html>
<html lang={locale} class="dark h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300..700&family=Noto+Sans+Thai:wght@300..700&family=Geist+Mono:wght@400..600&display=swap"
    />
  </head>
  <body class="min-h-full bg-background font-sans text-foreground">
    <slot />
    <script>
      import Lenis from "lenis";

      new Lenis({ lerp: 0.1, anchors: true, autoRaf: true });
    </script>
  </body>
</html>
