// TODO: replace with the real registration / payment link.
const REGISTER_URL = "#";

// Instructor cut-outs live in /public/workshop — render a placeholder until
// they're added.
const photo = (file: string) =>
  existsSync(`public/workshop/${file}`) ? `/workshop/${file}` : undefined;

type Card = { title: string; body: string };
type Plan = {
