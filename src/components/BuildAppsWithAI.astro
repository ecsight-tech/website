<script>
  // Navbar: pill once scrolled past the top (desktop); navbar and the mobile
  // CTA bar hide while the send-expand stage (full-screen app panel) covers
  // the middle of the viewport.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const ctaBar = document.querySelector<HTMLElement>("[data-cta-bar]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const setMenu = (open: boolean) => {
    nav?.toggleAttribute("data-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "ปิดเมนู" : "เปิดเมนู");
  };
  toggle?.addEventListener("click", () => setMenu(!nav?.hasAttribute("data-open")));
  // Close after picking a section.
  document.querySelectorAll("#mobile-menu a").forEach((a) => a.addEventListener("click", () => setMenu(false)));

  if (nav) {
    const onScroll = () => nav.toggleAttribute("data-scrolled", window.scrollY > 40);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    const hideFor = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? hideFor.add(e.target) : hideFor.delete(e.target);
        const hidden = hideFor.size > 0;
        nav.toggleAttribute("data-hidden", hidden);
        ctaBar?.toggleAttribute("data-hidden", hidden);
        if (hidden) setMenu(false);
      },
      { rootMargin: "-50% 0px -50% 0px" },
    );
    // The island hydrates late, so wait for its stage to appear.
    const watch = () => {
      const els = document.querySelectorAll("[data-hide-nav]");
      els.forEach((el) => io.observe(el));
      return els.length > 0;
    };
    if (!watch()) {
      const mo = new MutationObserver(() => watch() && mo.disconnect());
      mo.observe(document.body, { childList: true, subtree: true });
    }
  }
</script>

<script>
  // Inline testimonial playback without native controls: the tile itself is
  // the play/pause toggle and the corner badge shows state (via data-state on
  // the tile). One video plays at a time.
  const base = "/workshop/testimonials/";
  let current: { tile: HTMLElement; video: HTMLVideoElement } | null = null;

  // Preview loops: six videos painting at once made scrolling stutter, so
  // they only play while the section is on screen AND the page isn't
  // actively scrolling (resumed ~200ms after scroll stops). Reduced motion
  // keeps them on the still poster.
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const previews = [...document.querySelectorAll<HTMLVideoElement>("[data-preview]")];
  previews.forEach((v) => {
    v.removeAttribute("autoplay");
    v.pause();
  });
  let inView = false;
  let scrolling = false;
  let scrollTimer: ReturnType<typeof setTimeout>;
  const syncPreviews = () => {
    const run = inView && !scrolling && !reduceMotion;
    previews.forEach((v) => {
      if (current?.tile.contains(v)) return; // its tile is playing the full clip
      if (run) v.play().catch(() => {});
      else v.pause();
    });
  };
  const section = previews[0]?.closest("section");
  if (section) {
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      syncPreviews();
    }).observe(section);
  }
  addEventListener(
    "scroll",
    () => {
      if (!scrolling) {
        scrolling = true;
        syncPreviews();
      }
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        scrolling = false;
        syncPreviews();
      }, 200);
    },
    { passive: true },
  );
  const resumePreview = (tile: HTMLElement) => {
    if (inView && !scrolling && !reduceMotion)
      tile.querySelector<HTMLVideoElement>("[data-preview]")?.play().catch(() => {});
  };

  const stop = () => {
    if (!current) return;
    current.video.pause();
    current.video.remove(); // also stops any further buffering
    delete current.tile.dataset.state;
    resumePreview(current.tile);
    current = null;
  };

  const start = (tile: HTMLElement) => {
    stop();
    const slug = tile.dataset.testimonial;
    const video = document.createElement("video");
    video.playsInline = true;
    video.poster = `${base}${slug}.webp`;
    video.className = "pointer-events-none absolute inset-0 size-full object-cover";
    // AV1 first (smallest); HEVC for Safari on devices without AV1.
    video.innerHTML = `
      <source src="${base}${slug}.av1.mp4" type='video/mp4; codecs="av01.0.04M.10"'>
      <source src="${base}${slug}.hevc.mp4" type='video/mp4; codecs="hvc1"'>`;
    video.addEventListener("play", () => (tile.dataset.state = "playing"));
    video.addEventListener("pause", () => {
      if (current?.video === video) tile.dataset.state = "paused";
    });
    video.addEventListener("ended", stop);
    const preview = tile.querySelector<HTMLVideoElement>("[data-preview]")!;
    preview.pause();
    preview.after(video);
    current = { tile, video };
    video.play().catch(() => {});
  };

  document.querySelectorAll<HTMLElement>("[data-testimonial]").forEach((tile) => {
    tile.querySelector("[data-toggle]")!.addEventListener("click", () => {
      if (current?.tile !== tile) start(tile);
      else if (current.video.paused) current.video.play().catch(() => {});
      else current.video.pause();
    });
  });
</script>

<style is:global>
  /* Class-photo backdrop slideshow: every photo runs the same cycle (3s each), and
     a negative delay offsets photo i so photo 0 shows immediately and each
     one fades in as the previous fades out. Reduced motion keeps photo 0. */
  .class-backdrop {
    opacity: 0;
    animation: class-backdrop calc(var(--n) * 3s) linear infinite;
    animation-delay: calc((var(--i) - var(--n)) * 3s);
  }
  @keyframes class-backdrop {
    0%,
