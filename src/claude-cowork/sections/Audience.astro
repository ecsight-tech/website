---
import Reveal from "../components/Reveal.tsx";
import HighlightedHeading from "../components/HighlightedHeading";
import { personas } from "../data/content";
---

<section id="audience" class="bg-bg px-6 py-[120px] md:px-10 md:py-[160px]">
  <div class="mx-auto flex max-w-[1920px] flex-col">
    <HighlightedHeading
      client:visible
      prefix="Workshop นี้"
      highlight="เหมาะกับใคร?"
      align="center"
    />

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        personas.map((p, i) => (
          <Reveal client:visible delay={i * 0.06}>
            <article class="flex h-full flex-col items-start gap-8 rounded-4xl  bg-white/5 p-8 text-left md:text-center transition-colors hover:bg-white/10 md:items-center md:p-12">
              <p.icon className="size-12 text-brand md:size-20 md:mt-8" />
              <div class="flex flex-col gap-2 md:mt-16">
                <h3 class="text-2xl font-semibold text-white md:text-3xl">
                  {p.title}
                </h3>
                <p class="text-lg text-ink-muted md:text-xl mt-2">{p.body}</p>
              </div>
            </article>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
