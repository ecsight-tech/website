---
import HighlightedHeading from "../components/HighlightedHeading";
import Reveal from "../components/Reveal.tsx";
import { meta, workshop } from "../data/content";
---

<div class="relative bg-bg-deep">
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[60%]"
    style="background: radial-gradient(ellipse at bottom, color-mix(in oklab, var(--color-brand) 35%, transparent) 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>
  <section
    id="register"
    class="relative overflow-hidden px-6 py-[120px] md:px-10 md:py-[160px]"
  >
    <Reveal client:visible>
      <div
        class="relative mx-auto flex max-w-[900px] flex-col items-center gap-10 text-center"
      >
        <div class="max-w-2xl">
          <HighlightedHeading
            client:visible
            prefix=""
            highlight="เปลี่ยนวิธีทำงานของคุณ"
            suffix="ไปพร้อมกับเรา"
            align="center"
          />
        </div>

        <ul
          class="flex flex-col md:flex-row flex-wrap md:items-center justify-center gap-4 md:gap-6"
        >
          {
            meta.map(({ icon: Icon, label, href }) => (
              <li class="flex items-center gap-3 text-lg text-ink-muted md:text-xl lg:text-2xl">
                <Icon className="size-5 md:size-6" strokeWidth={2} />
                {href ? (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold underline underline-offset-4 hover:text-white"
                  >
                    {label}
                  </a>
                ) : (
                  <span class="font-semibold">{label}</span>
                )}
              </li>
            ))
          }
        </ul>

        <div class="flex flex-col items-center gap-5 mt-8">
          <a
            href={workshop.registerHref}
            class="inline-flex items-center justify-center rounded-[20px] bg-brand px-10 py-5 text-xl font-semibold text-white transition-transform duration-200 hover:-translate-y-0.5 md:text-2xl"
          >
            ลงทะเบียน Workshop
          </a>
          <p class="text-base text-ink-muted md:text-lg">
            เปิดรับสมัครแล้ว ที่นั่งจำนวนจำกัด
          </p>
        </div>
      </div>
    </Reveal>
  </section>

  <footer class="px-6 py-8 md:px-10">
    <div
      class="mx-auto flex max-w-[1140px] flex-col items-center justify-between gap-4 text-sm text-ink-muted md:flex-row md:text-base"
    >
      <p>© 2026 Data Echooo · Claude Cowork Workshop</p>
      <p>
        <a href={workshop.contactHref} class="text-white hover:text-brand"
          >{workshop.contactLabel}</a
        >
      </p>
    </div>
  </footer>
</div>
