---
interface Social {
  platform?: string;
  url?: string;
}

interface Props {
  brand?: string;
  email?: string;
  phone?: string;
  address?: string;
  socials?: Social[];
  description?: string;
  t: {
    rights: string;
    contact: string;
    follow: string;
    address: string;
    journey: string;
  };
}

const {
  brand = "ecsight",
  email,
  phone,
  address,
  socials = [],
  description,
  t,
} = Astro.props;
const year = new Date().getFullYear();
const wordmark = brand.toUpperCase();
---

<footer
  class="overflow-hidden border-t border-white/10 pt-16 h-[60vh] flex flex-col justify-between items-center"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-6 md:grid-cols-2 md:gap-8"
  >
    <div>
      <h2 class="font-heading text-lg font-semibold tracking-tight">
        1 Ecsight Group Co., Ltd.
      </h2>
      {
        description ? (
          <p class="mt-4 max-w-md text-sm leading-relaxed text-foreground/60">
            {description}
          </p>
        ) : null
      }
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 md:justify-items-start">
      {
        email ? (
          <div>
            <h3 class="font-medium">{t.contact}</h3>
            <a
              href={`mailto:${email}`}
              class="mt-1 block text-sm text-foreground/60 transition-colors hover:text-foreground"
            >
              {email}
            </a>
            {phone ? (
              <a
                href={`tel:${phone}`}
                class="mt-1 block text-sm text-foreground/60 transition-colors hover:text-foreground"
              >
                {phone}
              </a>
            ) : null}
          </div>
        ) : null
      }

      {
        socials.length ? (
          <div>
            <h3 class="font-medium">{t.follow}</h3>
            <ul class="mt-1 space-y-1">
              {socials.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-foreground/60 transition-colors hover:text-foreground"
                  >
                    {s.platform}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : null
      }

      {
        address ? (
          <div>
            <h3 class="font-medium">{t.address}</h3>
            <p class="mt-1 whitespace-pre-line text-sm text-foreground/60">
              {address}
            </p>
          </div>
        ) : null
      }
    </div>
  </div>

  <!-- <p class="mx-auto mt-12 max-w-6xl px-6 text-xs text-foreground/40">
    &copy; {year}
    {brand}. {t.rights}
  </p> -->

  <div
    class="mt-10 p-4 flex w-full select-none items-end gap-[2vw]"
    aria-hidden="true"
  >
    <svg
      class="h-[18vw] m-auto text-foreground opacity-10 translate-y-1/4"
      viewBox="0 0 1000 200"
      role="presentation"
    >
      <text
        x="0"
        y="175"
        textLength="1000"
        lengthAdjust="spacingAndGlyphs"
        fill="currentColor"
        font-size="200"
        font-weight="400"
        letter-spacing="-4"
        style="font-family: var(--font-heading, inherit); text-transform: uppercase;"
      >
        {wordmark}
      </text>
    </svg>
  </div>
</footer>
