---
import { Check, Gift } from "lucide-react";
import HighlightedHeading from "../components/HighlightedHeading";
import Reveal from "../components/Reveal.tsx";
import { pricingMeta, pricingTiers, workshop } from "../data/content";

const fmt = (n: number) => n.toLocaleString("th-TH");
---

<section id="pricing" class="bg-bg px-6 py-[120px] md:px-10 md:py-[160px]">
  <div class="mx-auto flex max-w-[1140px] flex-col gap-16">
    <HighlightedHeading
      client:visible
      prefix="ราคา Workshop"
      highlight="รุ่นที่ 7"
      align="center"
    />

    <div
      class:list={[
        "grid grid-cols-1 gap-6",
        pricingTiers.length > 1 ? "md:grid-cols-2" : "mx-auto w-full max-w-[560px]",
      ]}
    >
      {
        pricingTiers.map((tier, i) => (
          <Reveal client:visible delay={i * 0.08}>
            <article
              class:list={[
                "relative flex flex-col overflow-hidden rounded-3xl p-8 md:p-10",
                tier.highlight ? "bg-white/10 ring-1 ring-brand" : "bg-white/5",
              ]}
            >
              {tier.highlight && (
                <div
                  class="pointer-events-none absolute -right-24 -top-24 size-64 rounded-full bg-brand/20 blur-3xl"
                  aria-hidden="true"
                />
              )}

              <div class="flex flex-col gap-5">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-2xl font-semibold text-white md:text-3xl">
                    {tier.name}
                  </h3>
                  {tier.badge && (
                    <span
                      class:list={[
                        "inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] md:text-sm",
                        tier.highlight
                          ? "bg-brand text-white"
                          : "bg-white/10 text-ink",
                      ]}
                    >
                      {tier.badge}
                    </span>
                  )}
                </div>

                <div class="flex flex-col gap-1">
                  {tier.regular && (
                    <p class="text-lg text-ink-muted line-through md:text-xl">
                      {fmt(tier.regular)} {pricingMeta.currency}
                    </p>
                  )}
                  <div class="flex items-baseline gap-2">
                    <p class="text-5xl font-semibold text-white md:text-6xl">
                      {fmt(tier.price)}
                    </p>
                    <p class="text-xl text-ink-muted md:text-2xl">
                      {pricingMeta.currency}
                      {tier.priceSuffix ?? ""}
                    </p>
                  </div>
                  {tier.note && (
                    <p class="mt-2 text-sm text-ink-muted md:text-base">
                      {tier.note.match(/ECHO\d+/) ? (
                        <>
                          {tier.note.split(/(ECHO\d+)/).map((part) =>
                            /^ECHO\d+$/.test(part) ? (
                              <span class="font-bold text-white">{part}</span>
                            ) : (
                              part
                            )
                          )}
                        </>
                      ) : (
                        tier.note
                      )}
                    </p>
                  )}
                </div>
              </div>

              {tier.includes && (
                <ul class="mt-8 flex flex-col gap-3 md:mt-10">
                  {tier.includes.map((item) => (
                    <li class="flex items-start gap-3 text-base text-ink md:text-lg">
                      <Check className="mt-1 size-5 shrink-0 text-brand" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}

              {tier.bonus && (
                <div class="mt-6 rounded-3xl bg-brand/10 p-5 md:mt-8 md:p-6">
                  <div class="flex flex-col md:flex-row items-start gap-4">
                    <Gift className="shrink-0 text-brand size-10" />
                    <div class="flex flex-col gap-2">
                      <span class="text-xs font-semibold uppercase tracking-[0.15em] text-brand md:text-sm">
                        แถมฟรี (มูลค่า {fmt(tier.bonus.value)}{" "}
                        {pricingMeta.currency})
                      </span>
                      <h4 class="text-lg font-semibold text-white md:text-xl">
                        {tier.bonus.name}
                      </h4>
                      <p class="text-sm leading-relaxed text-ink-muted md:text-base">
                        {tier.bonus.description}
                      </p>
                    </div>
                  </div>
                </div>
              )}

              <div class="mt-auto pt-8 md:pt-10">
                <a
                  href={tier.registerHref ?? workshop.registerHref}
                  class:list={[
                    "inline-flex w-full items-center justify-center rounded-[20px] px-8 py-4 text-lg font-semibold transition-transform duration-200 hover:-translate-y-0.5 md:text-xl",
                    tier.highlight
                      ? "bg-brand text-white"
                      : "bg-white/10 text-white hover:bg-white/20",
                  ]}
                >
                  ลงทะเบียน
                </a>
                {tier.limit && (
                  <p class="mt-3 text-center text-sm text-ink-muted md:text-base">
                    {tier.limit}
                  </p>
                )}
              </div>
            </article>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
